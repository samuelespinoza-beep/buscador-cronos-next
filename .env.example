# Plantilla de configuración. Copiar a .env y completar con los valores del ambiente.
#
# Ninguna variable lleva el prefijo NEXT_PUBLIC_: ese prefijo hace que Next escriba el
# valor dentro del bundle del navegador, donde cualquiera puede leerlo. Todo esto se
# consume desde los route handlers de src/app/api, del lado del servidor.
#
# No hay valores por defecto en el código: si falta alguna, los endpoints responden 503
# "Buscador mal configurado". Es deliberado — preferimos fallar de inmediato antes que
# consultar en silencio el backend de otro ambiente.

# Backend de Cronos Printed. Cada ambiente apunta al suyo.
#   local : http://cronosprintedapi.glr.test/graphql  |  http://cronosprinted.glr.test/api
#   prod  : https://cronosprintedapi.glr.pe/graphql   |  https://cronosprinted.glr.pe/api
PRINTED_GRAPHQL_URL=
PRINTED_REST_API_URL=

# Credenciales que los route handlers agregan a cada llamada.
# PRINTED_TOKEN_ID      -> header token_id   del GraphQL
# PRINTED_SEARCH_API_KEY -> header X-Api-Key del REST
PRINTED_TOKEN_ID=
PRINTED_SEARCH_API_KEY=

# Puerto de la aplicación (Next.js usa 3000 por defecto).
PORT=3000
